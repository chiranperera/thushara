---
/**
 * Site header. Six nav items maximum — the original brief listed ten
 * screens, which would produce an unusable mobile menu.
 */
import { services, site } from "../../lib/site";
import type { SiteSettings } from "../../lib/settings";

interface Props { settings: SiteSettings }
const { settings } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));

// Grouped by life stage, not product type — it lets people
// self-identify before they even land on a page.
const groups = [
  { label: "Starting out", slugs: ["professional-indemnity", "motor-insurance", "travel-insurance"] },
  { label: "Building a family", slugs: ["life-income-protection", "health-insurance", "children-education"] },
  { label: "Planning ahead", slugs: ["retirement-plan", "house-property"] },
];
const byslug = (s: string) => services.find((x) => x.slug === s)!;
---

<header class="sticky top-0 z-50 border-b border-warm-200 bg-cream-50/95 backdrop-blur">
  <div class="container-default flex h-16 items-center justify-between gap-6 px-5 lg:h-20">
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label={`${site.name} — home`}>
      <svg width="26" height="24" viewBox="0 0 26 24" fill="none" aria-hidden="true" class="shrink-0">
        <path d="M1 7h24" stroke="#12544A" stroke-width="2" stroke-linecap="round" />
        <path d="M12 7v16" stroke="#12544A" stroke-width="2" stroke-linecap="round" />
        <circle cx="20" cy="7" r="4" fill="#C9962F" />
      </svg>
      <span class="leading-tight">
        <span class="block font-display text-[15px] font-bold text-ink-900">{site.name}</span>
        <span class="hidden text-caption text-warm-500 lg:block">{site.title}</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
      <a href="/about" class={`text-body font-medium hover:text-teal-400 ${isActive("/about") ? "text-teal-600" : "text-warm-700"}`}>About</a>

      <div class="group relative">
        <a href="/services" class={`flex items-center gap-1.5 text-body font-medium hover:text-teal-400 ${isActive("/services") ? "text-teal-600" : "text-warm-700"}`}>
          Services
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </a>
        {/* Mega-menu. Hover and focus-within so it is keyboard reachable.
            Columns size to their content and nothing wraps — a service
            name broken over two lines reads as two services. */}
        <div class="invisible absolute left-1/2 top-full z-50 w-max max-w-[calc(100vw-2.5rem)] -translate-x-1/2 pt-4 opacity-0 transition-[opacity,visibility] duration-200 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          {/* Gaps tighten at lg — at 1024px the full-width panel is
              centred on a trigger sitting left of centre, and would
              otherwise run off the left edge. */}
          <div class="grid grid-cols-[auto_auto_auto_auto] gap-x-6 rounded-xl border border-warm-200 bg-cream-50 px-6 py-7 shadow-lg xl:gap-x-10 xl:px-8">
            {groups.map((g) => (
              <div>
                <p class="overline mb-3.5 whitespace-nowrap text-teal-400">{g.label}</p>
                <ul class="flex flex-col gap-2.5">
                  {g.slugs.map((slug) => (
                    <li>
                      <a href={`/services/${slug}`} class="block whitespace-nowrap text-caption font-medium text-warm-700 hover:text-teal-600">
                        {byslug(slug).title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            <div class="border-l border-warm-200 pl-6 xl:pl-10">
              <p class="overline mb-3.5 whitespace-nowrap text-gold-600">For your profession</p>
              <ul class="flex flex-col gap-2.5">
                <li><a href="/for/doctors" class="block whitespace-nowrap text-caption font-bold text-teal-600 hover:text-teal-400">For Doctors →</a></li>
                <li><a href="/for/engineers" class="block whitespace-nowrap text-caption font-bold text-teal-600 hover:text-teal-400">For Engineers →</a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <a href="/process" class={`text-body font-medium hover:text-teal-400 ${isActive("/process") ? "text-teal-600" : "text-warm-700"}`}>Process</a>
      <a href="/testimonials" class={`text-body font-medium hover:text-teal-400 ${isActive("/testimonials") ? "text-teal-600" : "text-warm-700"}`}>Testimonials</a>
      <a href="/resources" class={`text-body font-medium hover:text-teal-400 ${isActive("/resources") ? "text-teal-600" : "text-warm-700"}`}>Resources</a>
    </nav>

    <div class="flex shrink-0 items-center gap-4">
      {settings.phoneHref && (
        <a href={settings.phoneHref} class="hidden text-small font-bold text-teal-600 hover:text-teal-400 xl:block">
          {settings.phone}
        </a>
      )}
      <a href="/book" class="hidden min-h-11 items-center rounded-full bg-teal-600 px-5 text-small font-bold text-cream-50 hover:bg-teal-500 lg:flex">
        Book a consultation
      </a>

      <button
        type="button" id="menu-open" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu"
        class="flex size-11 items-center justify-center lg:hidden"
      >
        <span class="flex flex-col gap-1.5" aria-hidden="true">
          <span class="block h-0.5 w-6 bg-ink-900"></span>
          <span class="block h-0.5 w-6 bg-ink-900"></span>
        </span>
      </button>
    </div>
  </div>
</header>

{/* Mobile drawer */}
<div id="mobile-menu" hidden class="fixed inset-0 z-60 lg:hidden">
  <div id="menu-backdrop" class="absolute inset-0 bg-ink-900/50"></div>
  <div class="absolute inset-y-0 right-0 flex w-full max-w-sm flex-col bg-cream-50">
    <div class="flex h-16 items-center justify-between border-b border-warm-200 px-5">
      <span class="font-display text-[15px] font-bold text-ink-900">Menu</span>
      <button type="button" id="menu-close" aria-label="Close menu" class="flex size-11 items-center justify-center text-h3 text-warm-700">×</button>
    </div>

    <nav class="flex-1 overflow-y-auto px-5 py-6" aria-label="Mobile">
      <ul class="flex flex-col gap-1">
        <li><a href="/about" class="flex min-h-13 items-center text-h4 font-bold text-ink-900">About</a></li>
      </ul>

      <p class="overline mt-6 mb-3 text-teal-400">Services</p>
      <ul class="flex flex-col gap-1">
        {services.map((s) => (
          <li><a href={`/services/${s.slug}`} class="flex min-h-12 items-center text-body text-warm-700">{s.title}</a></li>
        ))}
      </ul>

      <p class="overline mt-6 mb-3 text-gold-600">For your profession</p>
      <ul class="flex flex-col gap-1">
        <li><a href="/for/doctors" class="flex min-h-12 items-center text-body font-bold text-teal-600">For Doctors →</a></li>
        <li><a href="/for/engineers" class="flex min-h-12 items-center text-body font-bold text-teal-600">For Engineers →</a></li>
      </ul>

      <ul class="mt-6 flex flex-col gap-1 border-t border-warm-200 pt-6">
        {[["/process","Process"],["/testimonials","Testimonials"],["/gallery","Gallery"],["/resources","Resources"],["/faq","FAQ"],["/contact","Contact"]].map(([href,label]) => (
          <li><a href={href} class="flex min-h-12 items-center text-body text-warm-700">{label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="border-t border-warm-200 p-5">
      {settings.phoneHref && (
        <a href={settings.phoneHref} class="mb-3 block text-center text-body font-bold text-teal-600">{settings.phone}</a>
      )}
      <a href="/book" class="flex min-h-14 w-full items-center justify-center rounded-full bg-teal-600 text-body font-bold text-cream-50">
        Book a consultation
      </a>
    </div>
  </div>
</div>

<script>
  const menu = document.getElementById("mobile-menu")!;
  const openBtn = document.getElementById("menu-open")!;
  const closeBtn = document.getElementById("menu-close")!;
  const backdrop = document.getElementById("menu-backdrop")!;

  const open = () => {
    menu.hidden = false;
    openBtn.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
    closeBtn.focus();
  };
  const close = () => {
    menu.hidden = true;
    openBtn.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
    openBtn.focus();
  };

  openBtn.addEventListener("click", open);
  closeBtn.addEventListener("click", close);
  backdrop.addEventListener("click", close);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !menu.hidden) close();
  });
</script>
