---
/**
 * Shared shell for /privacy, /terms and /disclaimer.
 *
 * These are genuinely required, not filler: the site collects personal
 * data through booking, testimonials and downloads, and insurance is a
 * regulated activity in Sri Lanka supervised by the IRCSL.
 *
 * The wording below is DRAFT — structure and substance are right, but
 * the client must confirm the required regulatory language and check
 * whether SLIC imposes disclosure requirements on its consultants'
 * personal marketing. See design-brief/11, items A1–A2.
 */
import Layout from "./Layout.astro";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import type { SiteSettings } from "../lib/settings";

interface Props { title: string; heading: string; settings: SiteSettings; description?: string }
const { title, heading, settings, description } = Astro.props;
---

<Layout title={title} description={description ?? heading}>
  <Header slot="header" settings={settings} />

  <div class="bg-cream-50 py-14 md:py-20">
    <div class="container-prose px-5">
      <p class="overline text-navy-600">Legal</p>
      <h1 class="mt-4 font-display text-h1 font-extrabold text-ink-900">{heading}</h1>
      <p class="mt-3 text-small text-warm-500">Last updated · date pending</p>

      <span aria-hidden="true" class="mt-9 block h-px w-full bg-warm-200"></span>

      <div class="legal mt-9">
        <slot />
      </div>

      <div class="mt-12 border-l-2 border-gold-500 bg-cream-100 p-6">
        <p class="font-mono text-caption leading-relaxed text-warm-500">
          Draft wording for structure only. The client must confirm the required regulatory
          language, and check whether Sri Lanka Insurance Corporation imposes disclosure
          requirements on its consultants' personal marketing. This should be reviewed by someone
          qualified before launch.
        </p>
      </div>
    </div>
  </div>

  <Footer slot="footer" settings={settings} />
</Layout>

<style is:global>
  .legal h2 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 800;
    color: var(--color-navy-600);
    margin-top: 2.5rem;
  }
  .legal h2:first-child { margin-top: 0; }
  .legal p, .legal li {
    font-size: var(--text-body-lg);
    line-height: 1.75;
    color: var(--color-warm-800);
    margin-top: 1rem;
  }
  .legal ul { list-style: disc; padding-left: 1.4rem; }
  .legal a { color: var(--color-navy-600); text-decoration: underline; text-underline-offset: 3px; }
</style>
