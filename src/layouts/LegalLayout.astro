---
/**
 * Shared shell for /privacy, /terms and /disclaimer. The wording itself
 * is his, edited under Legal pages in the admin (lib/legal.ts).
 */
import Layout from "./Layout.astro";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import type { SiteSettings } from "../lib/settings";

interface Props { title: string; heading: string; settings: SiteSettings; description?: string; updatedAt?: string | null }
const { title, heading, settings, description, updatedAt } = Astro.props;

// Only shown once he has saved the page himself — the seeded first
// version carries no date, and an invented one would be worse than none.
const updated = updatedAt
  ? new Date(updatedAt).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "Asia/Colombo" })
  : null;
---

<Layout title={title} description={description ?? heading}>
  <Header slot="header" settings={settings} />

  <div class="bg-cream-50 py-14 md:py-20">
    <div class="container-prose px-5">
      <p class="eyebrow text-navy-600">Legal</p>
      <h1 class="mt-4 font-display text-h1 font-extrabold text-ink-900">{heading}</h1>
      {updated && <p class="mt-3 text-small text-warm-500">Last updated · {updated}</p>}

      <span aria-hidden="true" class="mt-9 block h-px w-full bg-warm-200"></span>

      <div class="legal mt-9">
        <slot />
      </div>

    </div>
  </div>

  <Footer slot="footer" settings={settings} />
</Layout>

<style is:global>
  .legal h2 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 800;
    color: var(--color-navy-600);
    margin-top: 2.5rem;
  }
  .legal h2:first-child { margin-top: 0; }
  .legal p, .legal li {
    font-size: var(--text-body-lg);
    line-height: 1.75;
    color: var(--color-warm-800);
    margin-top: 1rem;
  }
  .legal ul { list-style: disc; padding-left: 1.4rem; }
  .legal a { color: var(--color-navy-600); text-decoration: underline; text-underline-offset: 3px; }
</style>
