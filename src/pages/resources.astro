---
/**
 * /resources — "Free guides. No jargon."
 * Downloads take a name and WhatsApp number only, and tag the lead
 * with which guide was taken. One guide is deliberately ungated.
 */
export const prerender = false;

import { env } from "cloudflare:workers";
import Layout from "../layouts/Layout.astro";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import StickyBar from "../components/site/StickyBar.astro";
import { getSiteSettings, EDGE_CACHE } from "../lib/settings";
import { lifeStages } from "../lib/site";

const bindings = env as unknown as Record<string, any>;
const db = bindings.DB;
const settings = await getSiteSettings(db);
Astro.response.headers.set("cache-control", EDGE_CACHE);

let rows: any[] = [];
try {
  if (db) {
    const res = await db.prepare(
      `SELECT id, slug, title, description, life_stage, page_count, file_size, gated
       FROM resources WHERE published = 1 ORDER BY sort_order, id`).all();
    rows = res.results ?? [];
  }
} catch (e) { console.error("[resources] query failed", e); }

// Only guides he has uploaded in the admin. No planned slots: a card
// for a PDF that does not exist yet is a promise the page cannot keep.
const groups = lifeStages.map((s) => ({ ...s, items: rows.filter((i: any) => i.life_stage === s.id) }));
const ungrouped = rows.filter((i: any) => !lifeStages.some((s) => s.id === i.life_stage));
if (ungrouped.length) groups.push({ id: "other", label: "More guides", ageRange: "", items: ungrouped } as any);
---

<Layout title="Free guides" description="Written for people who have never bought insurance before, and who would rather read than be sold to.">
  <Header slot="header" settings={settings} />

  <section class="bg-cream-100 py-14 md:py-20">
    <div class="container-default px-5">
      <p class="eyebrow text-navy-600">Downloads</p>
      <h1 class="mt-4 font-display text-display font-extrabold leading-[1.04] tracking-[-0.03em] text-ink-900">
        Free guides. No jargon.
      </h1>
      <p class="mt-6 max-w-[58ch] text-body-lg leading-relaxed text-warm-700">
        Written for people who have never bought insurance before, and who would rather read than
        be sold to.
      </p>
    </div>
  </section>

  <section class="bg-cream-50 py-16 md:py-20">
    <div class="container-default flex flex-col gap-14 px-5">
      {groups.filter((g) => g.items.length).map((group) => (
        <div>
          <h2 class="flex flex-wrap items-baseline gap-4">
            <span class="font-display text-h2 font-extrabold text-navy-600">{group.label}</span>
            <span class="text-body font-medium text-warm-500">{group.ageRange}</span>
          </h2>
          <span aria-hidden="true" class="mt-4 block h-px w-full bg-gold-500/45"></span>

          <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {group.items.map((g: any) => (
              <li class="flex flex-col rounded-[20px] border border-warm-200 bg-white p-7">
                <span aria-hidden="true" class="relative flex h-16 w-12 items-center justify-center rounded-[4px] border border-warm-300 bg-cream-50 [clip-path:polygon(0_0,70%_0,100%_22%,100%_100%,0_100%)]">
              <span class="absolute right-0 top-0 h-[15px] w-[15px] rounded-bl-[2px] bg-warm-300"></span>
              <span class="rounded-[2px] bg-danger px-1.5 py-0.5 font-display text-[11px] font-extrabold leading-none tracking-wide text-white">PDF</span>
            </span>
                <span class="mt-5 font-display text-h4 font-bold leading-snug text-ink-900">{g.title}</span>
                <span class="mt-2.5 flex-1 text-body leading-relaxed text-warm-700">{g.description}</span>
                {g.page_count && (
                  <span class="mt-4 text-caption text-warm-500">{g.page_count} pages</span>
                )}
                {g.gated ? (
                  <a href={`/resources/${g.slug}`}
                     class="mt-5 flex min-h-13 items-center justify-center rounded-full bg-navy-600 text-body font-bold text-cream-50 hover:bg-navy-500">
                    Download
                  </a>
                ) : (
                  <a href={`/resources/${g.slug}`}
                     class="mt-5 flex min-h-13 items-center justify-center rounded-full border-[1.5px] border-navy-600 text-body font-bold text-navy-600 hover:bg-navy-50">
                    Read without giving details
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}

      {rows.length === 0 && (
        <p class="max-w-[58ch] text-body-lg leading-relaxed text-warm-700">
          New guides are on the way. Until then, if you have a question, message me and I'll answer it
          in plain language.
        </p>
      )}
    </div>
  </section>

  <Footer slot="footer" settings={settings} />
  <StickyBar slot="footer" settings={settings} message="Hello Thushara, I'd like to ask about insurance." />
</Layout>
