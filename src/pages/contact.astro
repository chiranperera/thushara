---
/**
 * /contact — Segment C's page. The phone number is the primary
 * element: a 51-year-old business owner will call, not fill a form.
 */
export const prerender = false;

import { env } from "cloudflare:workers";
import Layout from "../layouts/Layout.astro";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import StickyBar from "../components/site/StickyBar.astro";
import { getSiteSettings, EDGE_CACHE, whatsappHref } from "../lib/settings";
import { site } from "../lib/site";

const bindings = env as unknown as Record<string, any>;
const settings = await getSiteSettings(bindings.DB);
Astro.response.headers.set("cache-control", EDGE_CACHE);
const wa = whatsappHref(settings.whatsapp, "Hello Thushara, I'd like to ask about insurance.");
---

<Layout title="Contact" description={`Talk to ${site.name} — ${settings.serviceArea}.`}>
  <Header slot="header" settings={settings} />

  <div class="bg-cream-50 py-14 md:py-20">
    <div class="container-default grid gap-10 px-5 lg:grid-cols-[380px_1fr] lg:gap-16">
      <!-- talk to me -->
      <aside class="lg:sticky lg:top-28 lg:self-start">
        <div class="rounded-[20px] bg-ink-900 p-8">
          <h1 class="font-display text-h2 font-extrabold text-cream-50">Talk to me</h1>

          {settings.phoneHref ? (
            <>
              <a href={settings.phoneHref} class="mt-5 block font-display text-h1 font-extrabold text-gold-400 hover:text-gold-300">
                {settings.phone}
              </a>
              <p class="mt-2 text-small text-cream-50/60">Tap to call. This is the fastest way.</p>
            </>
          ) : (
            <p class="mt-5 font-display text-h2 font-extrabold text-cream-50/30">{site.contact.phoneDisplay}</p>
          )}

          <div class="mt-7 flex flex-col gap-3">
            {wa && (
              <a href={wa} class="flex min-h-14 items-center justify-center rounded-full bg-whatsapp text-h4 font-bold text-white">WhatsApp</a>
            )}
            {settings.emailHref && (
              <a href={settings.emailHref} class="flex min-h-14 items-center justify-center rounded-full border border-cream-50/35 text-h4 font-bold text-cream-50 hover:border-cream-50">Email</a>
            )}
            <a href="/book" class="flex min-h-14 items-center justify-center rounded-full bg-gold-500 text-h4 font-bold text-ink-900 hover:bg-gold-400">Book a consultation</a>
          </div>
        </div>

        <dl class="mt-8 flex flex-col gap-6">
          <div>
            <dt class="overline text-teal-600">Service area</dt>
            <dd class="mt-2 text-body-lg leading-relaxed text-warm-800">
              Based in Colombo. I travel island-wide for clients.
            </dd>
          </div>
          <div>
            <dt class="overline text-teal-600">Availability</dt>
            <dd class="mt-2 text-body-lg leading-relaxed text-warm-800">
              Weekdays during business hours, and evening or weekend appointments by arrangement.
            </dd>
          </div>
        </dl>
      </aside>

      <!-- prefer to write -->
      <div class="max-w-[560px]">
        <h2 class="font-display text-h2 font-extrabold text-teal-600">Prefer to write?</h2>
        <p class="mt-3 text-body-lg leading-relaxed text-warm-700">
          Leave a message and I'll come back to you. If you'd rather book a time directly,
          <a href="/book" class="font-bold text-teal-600 underline underline-offset-4">the booking form</a> takes about ninety seconds.
        </p>

        <form id="f" class="mt-9 flex flex-col gap-6" novalidate>
          <input type="hidden" name="profession_category" value="other" />
          <input type="hidden" name="profession_other" value="Contact form" />
          <input type="hidden" name="meeting_method" value="phone" />
          <input type="hidden" name="services" value="not-sure" />
          <input type="hidden" name="referring_page" value="/contact" />

          <div>
            <label for="name" class="text-small font-bold text-warm-800">Your name</label>
            <input id="name" name="name" required autocomplete="name"
              class="mt-2 h-14 w-full rounded-md border border-warm-200 bg-white px-4 text-body focus:border-teal-400" />
          </div>
          <div>
            <label for="phone" class="text-small font-bold text-warm-800">WhatsApp number</label>
            <div class="mt-2 flex">
              <span class="flex h-14 items-center rounded-l-md border border-r-0 border-warm-200 bg-warm-100 px-4 text-body text-warm-700">+94</span>
              <input id="phone" name="phone_whatsapp" type="tel" inputmode="numeric" required autocomplete="tel" placeholder="7X XXX XXXX"
                class="h-14 w-full rounded-r-md border border-warm-200 bg-white px-4 text-body focus:border-teal-400" />
            </div>
          </div>
          <div>
            <label for="email" class="text-small font-bold text-warm-800">Email address</label>
            <input id="email" name="email" type="email" required autocomplete="email"
              class="mt-2 h-14 w-full rounded-md border border-warm-200 bg-white px-4 text-body focus:border-teal-400" />
          </div>
          <div>
            <label for="notes" class="text-small font-bold text-warm-800">Your message</label>
            <textarea id="notes" name="notes" rows="5"
              class="mt-2 w-full rounded-md border border-warm-200 bg-white p-4 text-body leading-relaxed focus:border-teal-400"></textarea>
          </div>

          <div aria-hidden="true" class="absolute -left-[9999px] h-0 overflow-hidden">
            <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>

          <label class="flex cursor-pointer items-start gap-3">
            <input type="checkbox" name="consent" required class="mt-0.5 size-6 shrink-0 rounded border-[1.5px] border-warm-300 accent-teal-600" />
            <span class="text-body text-warm-900">
              I'm happy for Thushara to contact me about this enquiry.
              <a href="/privacy" class="text-teal-600 underline underline-offset-2">Privacy</a>
            </span>
          </label>

          <p id="err" class="hidden text-small text-danger"></p>

          <button type="submit" id="btn"
            class="flex min-h-14 w-full items-center justify-center rounded-full bg-teal-600 text-h4 font-bold text-cream-50 hover:bg-teal-500 disabled:opacity-70">
            Send message
          </button>
        </form>

        <div id="done" class="hidden">
          <span aria-hidden="true" class="flex size-14 items-center justify-center rounded-full bg-teal-600 text-h2 text-cream-50">✓</span>
          <h3 class="mt-6 font-display text-h2 font-extrabold text-ink-900">Thank you.</h3>
          <p class="mt-3 text-body-lg leading-relaxed text-warm-700">I'll come back to you shortly.</p>
        </div>
      </div>
    </div>
  </div>

  <Footer slot="footer" settings={settings} />
  <StickyBar slot="footer" settings={settings} message="Hello Thushara, I'd like to ask about insurance." />
</Layout>

<script>
  const form = document.getElementById("f") as HTMLFormElement;
  const btn = document.getElementById("btn") as HTMLButtonElement;
  const err = document.getElementById("err")!;
  const done = document.getElementById("done")!;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    err.classList.add("hidden");
    btn.disabled = true; btn.textContent = "Sending…";

    const fd = new FormData(form);
    const payload: Record<string, unknown> = Object.fromEntries(fd.entries());
    payload.consent = fd.get("consent") === "on";
    payload.services = ["not-sure"];
    // The lead endpoint needs a date/time; a message has neither, so
    // it is filed against today and Thushara arranges the time.
    const now = new Date();
    payload.preferred_date = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,"0")}-${String(now.getDate()).padStart(2,"0")}`;
    payload.preferred_time = "09:00";
    payload.preferred_contact = "whatsapp";

    try {
      const res = await fetch("/api/lead", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(payload) });
      const data = await res.json().catch(() => null);
      if (res.ok && data?.ok) { form.classList.add("hidden"); done.classList.remove("hidden"); return; }
      err.textContent = data?.fieldErrors ? Object.values(data.fieldErrors)[0] as string : (data?.message ?? "That didn't send. Please try again.");
      err.classList.remove("hidden");
    } catch {
      err.textContent = "That didn't send — please check your connection and try again.";
      err.classList.remove("hidden");
    }
    btn.disabled = false; btn.textContent = "Send message";
  });
</script>
