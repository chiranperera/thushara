---
/**
 * /terms — his own wording, edited under Legal pages in the admin.
 * See lib/legal.ts for the formatting rules and migration 0006 for the
 * seeded first version.
 */
export const prerender = false;
import { env } from "cloudflare:workers";
import LegalLayout from "../layouts/LegalLayout.astro";
import { getSiteSettings, EDGE_CACHE } from "../lib/settings";
import { getLegal, renderLegal } from "../lib/legal";

const bindings = env as unknown as Record<string, any>;
const settings = await getSiteSettings(bindings.DB);
const legal = await getLegal(bindings.DB, "terms");
Astro.response.headers.set("cache-control", EDGE_CACHE);
---

<LegalLayout title="Terms of use" heading="Terms of use" settings={settings} updatedAt={legal?.updatedAt ?? null} description="The terms on which this website is provided, and how reviews and information on it are handled.">
  {legal && <Fragment set:html={renderLegal(legal.text)} />}
</LegalLayout>
