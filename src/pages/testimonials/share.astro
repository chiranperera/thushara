---
/**
 * /testimonials/share — the review form Thushara sends to clients.
 * 6 Oct 2026, Chiran: not linked anywhere on the site; Thushara shares
 * the link himself (copy or WhatsApp from Admin › Reviews). Name, title,
 * the review and an optional photo. Posts to /api/testimonial, which
 * stores it as PENDING and emails him an approve link. Never
 * auto-published, never indexed.
 */
export const prerender = false;

import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/site/Header.astro";
import Footer from "../../components/site/Footer.astro";
import { getSiteSettings, EDGE_CACHE } from "../../lib/settings";

const bindings = env as unknown as Record<string, any>;
const settings = await getSiteSettings(bindings.DB);
Astro.response.headers.set("cache-control", EDGE_CACHE);

---

<Layout title="Share your experience" description="Two minutes, and it helps the next person decide whether to call." noindex>
  <Header slot="header" settings={settings} />

  <div class="bg-cream-50 py-14 md:py-20">
    <div class="container-narrow px-5">
      <div class="max-w-[560px]">
        <h1 class="font-display text-h1 font-extrabold text-ink-900">Share your experience</h1>
        <p class="mt-3 text-body-lg leading-relaxed text-warm-700">
          Thank you for doing this. It takes about two minutes.
        </p>

        <form id="f" class="mt-10 flex flex-col gap-6" novalidate>
          <div>
            <label for="name" class="text-small font-bold text-warm-800">Your name</label>
            <input id="name" name="name" required autocomplete="name"
              class="mt-2 h-14 w-full rounded-md border border-warm-200 bg-white px-4 text-body focus:border-navy-400" />
            <p class="err mt-2 hidden text-small text-danger"></p>
          </div>

          <div>
            <label for="profession" class="text-small font-bold text-warm-800">Your title or workplace</label>
            <input id="profession" name="profession" required maxlength="160"
              placeholder="e.g. Consultant Physician, Colombo"
              class="mt-2 h-14 w-full rounded-md border border-warm-200 bg-white px-4 text-body focus:border-navy-400" />
            <p class="err mt-2 hidden text-small text-danger"></p>
          </div>

          <div>
            <label for="body" class="text-small font-bold text-warm-800">Your experience</label>
            <textarea id="body" name="body" rows="5" required
              class="mt-2 w-full rounded-md border border-warm-200 bg-white p-4 text-body leading-relaxed focus:border-navy-400"></textarea>
            <p class="mt-1.5 text-small text-warm-500">A sentence or two is plenty.</p>
            <p class="err mt-2 hidden text-small text-danger"></p>
          </div>

          <div>
            <label for="photo" class="text-small font-bold text-warm-800">Your photo <span class="font-normal text-warm-500">(optional)</span></label>
            <input id="photo" name="photo" type="file" accept="image/jpeg,image/png,image/webp"
              class="mt-2 block w-full text-body text-warm-700 file:mr-4 file:rounded-full file:border-0 file:bg-navy-50 file:px-5 file:py-3 file:font-bold file:text-navy-600" />
            <p class="mt-1.5 text-small text-warm-500">A clear photo of your face works best. JPG or PNG, up to 6 MB.</p>
            <p class="err mt-2 hidden text-small text-danger"></p>
          </div>

          <div aria-hidden="true" class="absolute -left-[9999px] h-0 overflow-hidden">
            <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>

          <div>
            <label class="flex cursor-pointer items-start gap-3">
              <input type="checkbox" name="consent" required class="mt-0.5 size-6 shrink-0 rounded border-[1.5px] border-warm-300 accent-navy-600" />
              <span class="text-body text-warm-900">
                I'm happy for this to be published on the website, with my name, title and photo.
              </span>
            </label>
            <p class="err mt-2 hidden text-small text-danger"></p>
          </div>

          <button type="submit" id="btn"
            class="flex min-h-14 w-full items-center justify-center rounded-full bg-navy-600 text-h4 font-bold text-cream-50 hover:bg-navy-500 disabled:opacity-70">
            Send it to Thushara
          </button>
        </form>

        <div id="done" class="hidden">
          <span aria-hidden="true" class="flex size-14 items-center justify-center rounded-full bg-navy-600 text-h2 text-cream-50">✓</span>
          <h2 class="mt-6 font-display text-h1 font-extrabold text-ink-900">Thank you.</h2>
          <p class="mt-3 text-body-lg leading-relaxed text-warm-700">
            Thushara will review this and it will appear on the site shortly.
          </p>
          <a href="/" class="mt-7 inline-block text-body font-bold text-navy-600 hover:text-navy-400">Back to the site →</a>
        </div>
      </div>
    </div>
  </div>

  <Footer slot="footer" settings={settings} />
</Layout>

<script>
  const form = document.getElementById("f") as HTMLFormElement;
  const btn = document.getElementById("btn") as HTMLButtonElement;
  const done = document.getElementById("done")!;
  const wrap = form.parentElement!;

  const clearErrors = () => document.querySelectorAll(".err").forEach((e) => { e.classList.add("hidden"); e.textContent = ""; });
  const showError = (field: string, msg: string) => {
    const el = document.getElementById(field) ?? document.querySelector(`[name="${field}"]`);
    const err = el?.closest("div")?.querySelector(".err");
    if (err) { err.textContent = msg; err.classList.remove("hidden"); }
  };

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    clearErrors();
    btn.disabled = true;
    btn.textContent = "Sending…";

    const fd = new FormData(form);
    const photo = fd.get("photo");
    if (photo instanceof File && photo.size === 0) fd.delete("photo");

    try {
      const res = await fetch("/api/testimonial", { method: "POST", body: fd });
      const data = await res.json().catch(() => null);
      if (res.ok && data?.ok) {
        form.classList.add("hidden");
        done.classList.remove("hidden");
        wrap.scrollIntoView({ behavior: "smooth", block: "start" });
        return;
      }
      if (data?.fieldErrors) for (const [k, v] of Object.entries(data.fieldErrors)) showError(k, String(v));
    } catch {
      showError("body", "That didn't send — please check your connection and try again.");
    }
    btn.disabled = false;
    btn.textContent = "Send it to Thushara";
  });
</script>
