---
/**
 * /disclaimer — his own wording, edited under Legal pages in the admin.
 * See lib/legal.ts for the formatting rules and migration 0006 for the
 * seeded first version.
 */
export const prerender = false;
import { env } from "cloudflare:workers";
import LegalLayout from "../layouts/LegalLayout.astro";
import { getSiteSettings, EDGE_CACHE } from "../lib/settings";
import { getLegal, renderLegal } from "../lib/legal";

const bindings = env as unknown as Record<string, any>;
const settings = await getSiteSettings(bindings.DB);
const legal = await getLegal(bindings.DB, "disclaimer");
Astro.response.headers.set("cache-control", EDGE_CACHE);
---

<LegalLayout title="Insurance disclaimer" heading="Insurance disclaimer" settings={settings} updatedAt={legal?.updatedAt ?? null} description="What this website is and is not: general information about Sri Lanka Insurance Corporation products, not personalised financial advice.">
  {legal && <Fragment set:html={renderLegal(legal.text)} />}
</LegalLayout>
