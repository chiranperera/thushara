---
/**
 * /admin/profile — the numbers that go stale.
 * years_experience and mdrt_years appear in the hero, the credentials
 * band and the footer of every page. He must be able to change them
 * himself: nobody should call a developer to update a number.
 */
export const prerender = false;

import { env } from "cloudflare:workers";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { requireAdmin } from "../../lib/auth";
import { getCounts } from "../../lib/admin-data";
import { currentYear, yearsSince } from "../../lib/clock";
import { site } from "../../lib/site";

const bindings = env as unknown as Record<string, any>;
const db = bindings.DB;
const admin = await requireAdmin(Astro.request, bindings.AUTH_SECRET ?? "");
if (!admin) return Astro.redirect("/admin/login");

const counts = await getCounts(db);
const saved = Astro.url.searchParams.get("saved");

let settings = new Map<string, string>();
if (db) {
  try {
    const s = await db.prepare(`SELECT key, value FROM settings`).all();
    settings = new Map((s.results ?? []).map((r: any) => [r.key, r.value]));
  } catch (e) { console.error("[admin] profile query failed", e); }
}
const val = (k: string) => { const v = settings.get(k); return !v || v === "PENDING" ? "" : v; };

// Show him the numbers his start years actually produce, so the effect
// of what he types is visible rather than something he has to imagine.
const thisYear = currentYear();
const derived = {
  years: yearsSince(Number(settings.get("experience_since")) || site.credentials.experienceSince),
  mdrt: yearsSince(Number(settings.get("mdrt_since")) || site.credentials.mdrtSince, { inclusive: true }),
};
const pending = (k: string) => settings.get(k) === "PENDING";
---

<AdminLayout title="My details" newLeads={counts.newLeads} pendingReviews={counts.pendingReviews}>
  <div class="px-5 py-8 md:px-11 md:py-9">
    <h1 class="font-display text-h1 font-extrabold text-ink-900">My details</h1>
    <p class="mt-1.5 text-body text-warm-500">These appear across the website.</p>

    {saved && <p class="mt-5 rounded-lg border border-navy-200 bg-navy-50 px-4 py-3 text-body text-navy-600">Saved.</p>}

    <form method="POST" action="/api/admin/settings" class="mt-8 max-w-[520px]">
      <input type="hidden" name="_section" value="profile" />

      <div class="flex flex-col gap-5">
        {[
          { name:"phone", label:"Phone", type:"tel", placeholder:"+94 XX XXX XXXX" },
          { name:"phone_secondary", label:"Second phone", type:"tel", placeholder:"+94 XX XXX XXXX" },
          { name:"whatsapp", label:"WhatsApp number", type:"tel", placeholder:"+94 XX XXX XXXX" },
          { name:"whatsapp_secondary", label:"Second WhatsApp number", type:"tel", placeholder:"+94 XX XXX XXXX" },
          { name:"email", label:"Email", type:"email", placeholder:"you@yourdomain.com" },
          { name:"service_area", label:"Service area", type:"text", placeholder:"Island-wide · Colombo & suburbs" },
          { name:"mdrt_status", label:"MDRT status", type:"text", placeholder:"Lifetime Member" },
          { name:"recognition", label:"Award or recognition line", type:"text", placeholder:"Top Performer in Life & General Insurance, Regional" },
        ].map((f)=>(
          <div>
            <label for={f.name} class="text-small font-bold text-warm-800">{f.label}</label>
            <input
              id={f.name} name={f.name} type={f.type} value={val(f.name)} placeholder={f.placeholder}
              class="mt-2 h-14 w-full rounded-md border border-warm-200 bg-white px-4 text-body focus:border-navy-400"
            />
            {pending(f.name) && (
              <p class="mt-1.5 text-small text-gold-600">Not set yet — the website hides this until you fill it in.</p>
            )}
          </div>
        ))}
      </div>

      <div class="mt-7 rounded-[18px] bg-ink-900 p-6">
        <p class="eyebrow text-gold-400">Shown on every page</p>

        {/* Years of experience is a start year: he types it once and
            the count grows by itself every 1 January. MDRT is a count he
            sets himself, because it counts qualifications — a year he
            does not qualify must not add one. */}
        <div class="mt-4 grid gap-3.5 sm:grid-cols-2">
          <div>
            <label for="experience_since" class="text-small font-bold text-cream-50/80">The year you started</label>
            <input
              id="experience_since" name="experience_since" type="number" min="1970" max={String(thisYear)}
              value={settings.get("experience_since") ?? ""} placeholder="Appointed 2010"
              class="mt-2 h-14 w-full rounded-md border border-cream-50/25 bg-cream-50/6 px-4 font-display text-h3 font-extrabold tabular text-cream-50 focus:border-gold-400"
            />
            <p class="mt-2 text-small text-gold-400">Currently shows: <b>{derived.years} years' experience</b></p>
          </div>
          <div>
            <label for="mdrt_since" class="text-small font-bold text-cream-50/80">Your first MDRT year</label>
            <input
              id="mdrt_since" name="mdrt_since" type="number" min="1970" max={String(thisYear)}
              value={settings.get("mdrt_since") ?? ""} placeholder="First qualified 2013"
              class="mt-2 h-14 w-full rounded-md border border-cream-50/25 bg-cream-50/6 px-4 font-display text-h3 font-extrabold tabular text-cream-50 focus:border-gold-400"
            />
            <p class="mt-2 text-small text-gold-400">Currently shows: <b>{derived.mdrt}× MDRT</b></p>
          </div>
        </div>

        <p class="mt-4 rounded-lg bg-cream-50/8 px-4 py-3 text-small leading-relaxed text-cream-50/75">
          You do not need to update these. On 1 January both numbers go up by one on their own —
          this year {derived.years} years and {derived.mdrt}× MDRT, next year {derived.years + 1} years
          and {derived.mdrt + 1}× MDRT.
        </p>

        {/* Court of the Table is deliberately not automatic. He
            qualifies for it in some years and not others, so only he
            knows when it changes. */}
        <div class="mt-6 border-t border-cream-50/15 pt-5">
          <label for="cot_year_list" class="text-small font-bold text-cream-50/80">
            Court of the Table — the years you reached it
          </label>
          <input
            id="cot_year_list" name="cot_year_list" type="text" inputmode="numeric"
            value={settings.get("cot_year_list") ?? ""} placeholder="2020, 2024, 2025, 2026"
            class="mt-2 h-14 w-full rounded-md border border-cream-50/25 bg-cream-50/6 px-4 font-display text-h4 font-extrabold tabular text-cream-50 focus:border-gold-400"
          />
          <p class="mt-2.5 text-small leading-relaxed text-cream-50/65">
            This one does <b>not</b> update itself, because you do not qualify every year.
            Add the new year here, separated by commas, the year you qualify again. The website
            counts them for you.
          </p>
        </div>
      </div>

      <button type="submit" class="mt-8 flex min-h-14 w-full items-center justify-center rounded-full bg-navy-600 text-h4 font-bold text-cream-50 hover:bg-navy-500 sm:w-auto sm:px-12">
        Save
      </button>
    </form>
  </div>
</AdminLayout>
