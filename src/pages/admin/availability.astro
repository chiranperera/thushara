---
/**
 * /admin/availability — drives the booking slot picker.
 * 6 Oct 2026, Chiran: one row per day of the week. Thushara picks the
 * start and end time for each day and switches the day on or off.
 */
export const prerender = false;

import { env } from "cloudflare:workers";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { requireAdmin } from "../../lib/auth";
import { getCounts } from "../../lib/admin-data";

const bindings = env as unknown as Record<string, any>;
const db = bindings.DB;
const admin = await requireAdmin(Astro.request, bindings.AUTH_SECRET ?? "");
if (!admin) return Astro.redirect("/admin/login");

const counts = await getCounts(db);
const saved = Astro.url.searchParams.get("saved");

let windows: any[] = [];
let settings = new Map<string, string>();
let blocked: any[] = [];
if (db) {
  try {
    const [w, s, b] = await db.batch([
      db.prepare(`SELECT * FROM availability ORDER BY day_of_week, start_time`),
      db.prepare(`SELECT key, value FROM settings`),
      db.prepare(`SELECT date, reason FROM blocked_dates WHERE date >= date('now') ORDER BY date LIMIT 30`),
    ]);
    windows = w.results ?? [];
    settings = new Map((s.results ?? []).map((r: any) => [r.key, r.value]));
    blocked = b.results ?? [];
  } catch (e) { console.error("[admin] availability query failed", e); }
}

const num = (k: string, d: number) => Number(settings.get(k)) || d;
const paused = settings.get("bookings_paused") === "1";
const DAY = ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];
/** Monday first, the way he reads a week. One row per day. */
const week = [1, 2, 3, 4, 5, 6, 0].map((dow) => {
  const w = windows.find((r) => r.day_of_week === dow);
  return { dow, name: DAY[dow], start: w?.start_time ?? "09:00", end: w?.end_time ?? "17:00", on: w ? w.active === 1 : false };
});
const badTimes = Astro.url.searchParams.get("times") === "bad";
---

<AdminLayout title="When I'm available" newLeads={counts.newLeads} pendingReviews={counts.pendingReviews}>
  <div class="px-5 py-8 md:px-11 md:py-9">
    <h1 class="font-display text-h1 font-extrabold text-ink-900">When I'm available</h1>
    <p class="mt-1.5 text-body text-warm-500">This controls the times people can pick when they book.</p>

    {saved && <p class="mt-5 rounded-lg border border-navy-200 bg-navy-50 px-4 py-3 text-body text-navy-600">Saved.</p>}

    <form method="POST" action="/api/admin/settings" class="mt-8 max-w-[760px]">
      <input type="hidden" name="_section" value="availability" />

      {badTimes && (
        <p class="mb-4 rounded-lg border border-error/30 bg-error/8 px-4 py-3 text-body text-error">
          A day's end time must be later than its start time. Those days were left as they were.
        </p>
      )}
      <div class="overflow-hidden rounded-[18px] border border-warm-200 bg-white">
        <div class="grid grid-cols-[1.1fr_1fr_1fr_auto] gap-3 border-b border-warm-200 bg-cream-100 px-5">
          {["Day","Start","End","Open"].map((h)=>(
            <div class="py-3.5 text-caption font-bold tracking-[.06em] uppercase text-navy-600/80">{h}</div>
          ))}
        </div>
        {week.map((d)=>(
          <div class="grid grid-cols-[1.1fr_1fr_1fr_auto] items-center gap-3 border-b border-warm-100 px-5 py-3 last:border-0">
            <div class="text-body font-bold text-ink-800">{d.name}</div>
            <input type="time" name={`start_${d.dow}`} value={d.start} step="900" aria-label={`${d.name} start time`}
              class="h-12 w-full rounded-md border border-warm-200 bg-white px-3 text-body tabular focus:border-navy-400" />
            <input type="time" name={`end_${d.dow}`} value={d.end} step="900" aria-label={`${d.name} end time`}
              class="h-12 w-full rounded-md border border-warm-200 bg-white px-3 text-body tabular focus:border-navy-400" />
            <label class="flex cursor-pointer items-center justify-center px-2">
              <input type="checkbox" name={`on_${d.dow}`} checked={d.on} class="size-6 accent-navy-600" />
              <span class="sr-only">{d.name} open for bookings</span>
            </label>
          </div>
        ))}
      </div>

      <p class="mt-3 text-small leading-relaxed text-warm-600">
        Untick a day you don't work. People can only pick times between the start and end you set.
      </p>

      <div class="mt-7 grid gap-4 sm:grid-cols-2">
        {[
          { name:"appointment_minutes", label:"Appointment length", value:num("appointment_minutes",30), suffix:"minutes", hint:"How long each meeting lasts." },
          { name:"buffer_minutes", label:"Gap between appointments", value:num("buffer_minutes",15), suffix:"minutes", hint:"Rest time after each meeting before the next can start." },
          { name:"max_per_day", label:"Most bookings in a day", value:num("max_per_day",4), suffix:"per day", hint:"Once this many people have booked a day, its other times are hidden — even if your hours have room for more." },
        ].map((f)=>(
          <div>
            <label for={f.name} class="text-small font-bold text-warm-800">{f.label}</label>
            <div class="mt-2 flex items-center gap-3">
              <input id={f.name} name={f.name} type="number" min="1" value={f.value}
                class="h-14 w-28 rounded-md border border-warm-200 bg-white px-4 text-h4 tabular focus:border-navy-400" />
              {f.suffix && <span class="text-body text-warm-500">{f.suffix}</span>}
            </div>
            <p class="mt-1.5 max-w-[36ch] text-small leading-relaxed text-warm-500">{f.hint}</p>
          </div>
        ))}
      </div>

      <div class="mt-7 flex items-center justify-between gap-6 rounded-[18px] border border-warm-200 bg-cream-100 p-6">
        <div>
          <p class="text-h4 font-bold text-ink-800">Pause bookings</p>
          <p class="mt-1 max-w-[44ch] text-body leading-relaxed text-warm-700">
            For when you're away. People see a short message and your WhatsApp number instead of the calendar.
          </p>
        </div>
        <input type="checkbox" name="bookings_paused" checked={paused} class="size-7 shrink-0 accent-navy-600" />
      </div>

      {blocked.length > 0 && (
        <div class="mt-7">
          <p class="text-small font-bold text-warm-800">Days you're away</p>
          <ul class="mt-2 flex flex-wrap gap-2">
            {blocked.map((b)=>(
              <li class="rounded-full border border-warm-200 bg-white px-4 py-2 text-small text-warm-700">
                {b.date}{b.reason ? ` · ${b.reason}` : ""}
              </li>
            ))}
          </ul>
        </div>
      )}

      <button type="submit" class="mt-8 flex min-h-14 w-full items-center justify-center rounded-full bg-navy-600 text-h4 font-bold text-cream-50 hover:bg-navy-500 sm:w-auto sm:px-12">
        Save
      </button>
    </form>
  </div>
</AdminLayout>

<script>
  // 6 Oct 2026, Chiran: the time picker only opened from the little clock
  // icon. Clicking anywhere in the box now opens it.
  document.querySelectorAll<HTMLInputElement>('input[type="time"]').forEach((el) => {
    el.style.cursor = "pointer";
    el.addEventListener("click", () => {
      try { el.showPicker(); } catch {}
    });
  });
</script>
