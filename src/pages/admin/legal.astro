---
/**
 * /admin/legal — his privacy policy, terms and disclaimer.
 *
 * These are his own policies, so he owns the wording. One form per page:
 * saving the disclaimer never touches the privacy policy.
 */
export const prerender = false;

import { env } from "cloudflare:workers";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { requireAdmin } from "../../lib/auth";
import { getCounts } from "../../lib/admin-data";
import { LEGAL_PAGES, LEGAL_MAX, getLegal, type LegalPage } from "../../lib/legal";

const bindings = env as unknown as Record<string, any>;
const db = bindings.DB;
const admin = await requireAdmin(Astro.request, bindings.AUTH_SECRET ?? "");
if (!admin) return Astro.redirect("/admin/login");

const counts = await getCounts(db);
const saved = Astro.url.searchParams.get("saved");

const pages = await Promise.all(
  (Object.keys(LEGAL_PAGES) as LegalPage[]).map(async (slug) => ({
    slug,
    ...LEGAL_PAGES[slug],
    text: (await getLegal(db, slug))?.text ?? "",
  })),
);
---

<AdminLayout title="Legal pages" newLeads={counts.newLeads} pendingReviews={counts.pendingReviews}>
  <div class="px-5 py-8 md:px-11 md:py-9">
    <h1 class="font-display text-h1 font-extrabold text-ink-900">Legal pages</h1>
    <p class="mt-1.5 max-w-[64ch] text-body text-warm-500">
      Your privacy policy, terms and disclaimer, exactly as visitors see them. Change the wording
      here whenever you need to.
    </p>
    <p class="mt-3 max-w-[64ch] rounded-lg bg-cream-100 px-4 py-3 text-small leading-relaxed text-warm-700">
      Leave an empty line between paragraphs. Start a line with <b>##&nbsp;</b> to make it a heading,
      and with <b>-&nbsp;</b> to make it a bullet point.
    </p>

    {saved && <p class="mt-5 rounded-lg border border-navy-200 bg-navy-50 px-4 py-3 text-body text-navy-600">Saved. It's live on the website now.</p>}

    {pages.map((p) => (
      <form method="POST" action="/api/admin/settings" class="mt-8 max-w-[860px] rounded-[18px] border border-warm-200 bg-white p-6">
        <input type="hidden" name="_section" value="legal" />
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h2 class="font-display text-h3 font-extrabold text-ink-900">{p.label}</h2>
          <a href={`/${p.slug}`} target="_blank" rel="noopener" class="text-small font-bold text-navy-600 underline underline-offset-2 hover:text-navy-400">View page</a>
        </div>
        <textarea name={p.key} rows="18" maxlength={LEGAL_MAX}
          class="mt-4 w-full rounded-md border border-warm-200 bg-white px-3.5 py-3 text-body leading-relaxed text-ink-900 focus:border-navy-400">{p.text}</textarea>
        <button type="submit" class="mt-4 flex min-h-12 items-center rounded-full bg-navy-600 px-7 text-body font-bold text-cream-50 hover:bg-navy-500">
          Save {p.label.toLowerCase()}
        </button>
      </form>
    ))}
  </div>
</AdminLayout>
