---
/**
 * /admin/testimonials — pending and published reviews.
 *
 * Full submitted text is shown in place, never truncated, so he can
 * judge it without opening anything else.
 */
export const prerender = false;

import { env } from "cloudflare:workers";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireAdmin } from "../../../lib/auth";
import { getCounts, relativeTime, type TestimonialRow } from "../../../lib/admin-data";

const field = "h-13 w-full rounded-md border border-warm-200 bg-white px-3.5 text-body text-ink-900 focus:border-navy-400";

const bindings = env as unknown as Record<string, any>;
const db = bindings.DB;

const admin = await requireAdmin(Astro.request, bindings.AUTH_SECRET ?? "");
if (!admin) return Astro.redirect("/admin/login");

const counts = await getCounts(db);
const tab = Astro.url.searchParams.get("tab") === "published" ? "published" : "pending";
const ok = Astro.url.searchParams.get("ok");
const err = Astro.url.searchParams.get("e");

let rows: TestimonialRow[] = [];
if (db) {
  try {
    const res = await db
      .prepare(`SELECT * FROM testimonials WHERE status = ? ORDER BY featured DESC, sort_order, created_at DESC`)
      .bind(tab)
      .all();
    rows = (res.results ?? []) as TestimonialRow[];
  } catch (e) {
    console.error("[admin] testimonials query failed", e);
  }
}

let intro = "";
if (db) {
  try {
    const r = await db.prepare(`SELECT value FROM settings WHERE key='testimonials_intro'`).first<{ value: string }>();
    intro = r?.value && r.value !== "PENDING" ? r.value : "";
  } catch (e) { console.error("[admin] intro read failed", e); }
}

const saved = Astro.url.searchParams.get("saved");
const notices: Record<string, string> = {
  published: "Published. It's live on the website now.",
  already: "That one was already published.",
};
const problems: Record<string, string> = {
  invalid: "That approval link is no longer valid. You can publish it from here instead.",
  failed: "Something went wrong publishing that. Please try again.",
  empty: "Please fill in the name, the title and what they said.",
  consent: "Please tick the box confirming you have their permission.",
  filetype: "That photo needs to be a JPG, PNG or WebP.",
  filesize: "That photo is too large. The limit is 6 MB.",
  upload: "The photo didn't upload. Please try again.",
  save: "That didn't save. Please try again.",
};
---

<AdminLayout title="Reviews" newLeads={counts.newLeads} pendingReviews={counts.pendingReviews}>
  <div class="px-5 py-8 md:px-11 md:py-9">
    <h1 class="font-display text-h1 font-extrabold text-ink-900">Reviews</h1>
    <p class="mt-1.5 text-body text-warm-500">Nothing appears on the website until you approve it.</p>

    {ok && notices[ok] && (
      <p class="mt-5 rounded-lg border border-navy-200 bg-navy-50 px-4 py-3 text-body text-navy-600">{notices[ok]}</p>
    )}
    {err && problems[err] && (
      <p class="mt-5 rounded-lg border border-gold-300 bg-gold-100 px-4 py-3 text-body text-warm-900">{problems[err]}</p>
    )}
    {Astro.url.searchParams.get("error") && problems[Astro.url.searchParams.get("error")!] && (
      <p class="mt-5 rounded-lg border border-gold-300 bg-gold-100 px-4 py-3 text-body text-warm-900">
        {problems[Astro.url.searchParams.get("error")!]}
      </p>
    )}
    {saved && (
      <p class="mt-5 rounded-lg border border-navy-200 bg-navy-50 px-4 py-3 text-body text-navy-600">Saved.</p>
    )}

    <!-- ============ THE LINE ABOVE THE CAROUSEL ============ -->
    <form method="POST" action="/api/admin/settings" class="mt-8 max-w-[860px] rounded-[18px] border border-warm-200 bg-white p-6">
      <input type="hidden" name="_section" value="testimonials" />
      <h2 class="font-display text-h3 font-extrabold text-ink-900">The line above the reviews</h2>
      <p class="mt-1.5 max-w-[64ch] text-small leading-relaxed text-warm-600">
        This sits on the homepage just above the moving reviews. Say who you look after and what
        kind of work they do. Only claim numbers you could stand behind if asked.
      </p>
      <textarea name="testimonials_intro" rows="3" maxlength="600"
        class="mt-4 w-full rounded-md border border-warm-200 bg-white px-3.5 py-3 text-body leading-relaxed text-ink-900 focus:border-navy-400"
        placeholder="More than 1,000 professionals trust me with their cover — among them consultant cardiac surgeons, orthopaedic surgeons and neurosurgeons.">{intro}</textarea>
      <button type="submit" class="mt-4 flex min-h-12 items-center rounded-full bg-navy-600 px-7 text-body font-bold text-cream-50 hover:bg-navy-500">
        Save this line
      </button>
    </form>

    <!-- ============ ADD ONE YOURSELF ============ -->
    <details class="group mt-6 max-w-[860px] rounded-[18px] border border-warm-200 bg-cream-100 p-6">
      <summary class="cursor-pointer list-none font-display text-h3 font-extrabold text-ink-900">
        + Add a review yourself
      </summary>
      <p class="mt-2 max-w-[64ch] text-small leading-relaxed text-warm-600">
        For reviews you collect in person. These go straight onto the website, so only add words
        the person actually said.
      </p>

      <form method="POST" action="/api/admin/testimonials/create" enctype="multipart/form-data" class="mt-5 flex flex-col gap-4">
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="t-name" class="text-small font-bold text-warm-800">Their name</label>
            <input id="t-name" name="name" required maxlength="120" class={`${field} mt-2`} placeholder="Dr Nimal Perera" />
          </div>
          <div>
            <label for="t-prof" class="text-small font-bold text-warm-800">Their title</label>
            <input id="t-prof" name="profession" required maxlength="160" class={`${field} mt-2`} placeholder="Consultant Cardiac Surgeon" />
          </div>
        </div>

        <div>
          <label for="t-body" class="text-small font-bold text-warm-800">What they said</label>
          <textarea id="t-body" name="body" required rows="4" maxlength="2000"
            class="mt-2 w-full rounded-md border border-warm-200 bg-white px-3.5 py-3 text-body leading-relaxed text-ink-900 focus:border-navy-400"
            placeholder="Their own words. Keep it as they said it."></textarea>
        </div>

        <div>
          <label for="t-photo" class="text-small font-bold text-warm-800">
            Their photo <span class="font-normal text-warm-500">— optional</span>
          </label>
          <input id="t-photo" name="photo" type="file" accept="image/jpeg,image/png,image/webp"
            class="mt-2 w-full rounded-md border border-warm-200 bg-white p-3 text-body text-warm-700 file:mr-3 file:rounded-full file:border-0 file:bg-navy-600 file:px-5 file:py-2.5 file:text-body file:font-bold file:text-cream-50" />
          <p class="mt-1.5 text-small text-warm-500">
            JPG, PNG or WebP, up to 6 MB. Without one the card shows their initials instead.
          </p>
        </div>

        {/* A real doctor's name, face and words go on a public page.
            There is no email round-trip here to prove they agreed, so
            the least this can do is record that he said they did. */}
        <label class="flex items-start gap-3 rounded-lg border border-gold-300 bg-gold-100/50 p-4">
          <input type="checkbox" name="consent" value="1" required class="mt-0.5 size-6 shrink-0 accent-navy-600" />
          <span class="text-body leading-relaxed text-warm-800">
            I have their permission to publish their name, photo and words on this website.
          </span>
        </label>

        <button type="submit" class="flex min-h-13 w-fit items-center rounded-full bg-navy-600 px-8 text-body font-bold text-cream-50 hover:bg-navy-500">
          Add to the website
        </button>
      </form>
    </details>

    <div class="mt-6 flex gap-2">
      <a
        href="/admin/testimonials"
        class={`rounded-full px-4.5 py-2.5 text-small ${tab === "pending" ? "bg-navy-600 font-bold text-cream-50" : "border border-warm-200 text-warm-700"}`}
      >Pending{counts.pendingReviews ? ` · ${counts.pendingReviews}` : ""}</a>
      <a
        href="/admin/testimonials?tab=published"
        class={`rounded-full px-4.5 py-2.5 text-small ${tab === "published" ? "bg-navy-600 font-bold text-cream-50" : "border border-warm-200 text-warm-700"}`}
      >Published</a>
    </div>

    {rows.length === 0 ? (
      <div class="mt-8 rounded-xl border border-warm-200 bg-cream-100 p-10 text-center">
        <p class="text-h4 font-bold text-ink-900">
          {tab === "pending" ? "Nothing waiting for you." : "No published reviews yet."}
        </p>
        <p class="mx-auto mt-2 max-w-[46ch] text-body text-warm-500">
          {tab === "pending"
            ? "When a client submits a review it will appear here for you to approve."
            : "Once you approve a review it will show here, and on the website."}
        </p>
      </div>
    ) : (
      <ul class="mt-7 flex max-w-[720px] flex-col gap-3.5">
        {rows.map((t) => (
          <li class="rounded-[18px] border border-warm-200 bg-white p-6">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="text-h4 font-bold text-ink-800">{t.name}</p>
                <p class="mt-0.5 text-small text-warm-500">
                  {t.profession}{t.service ? ` · ${t.service}` : ""} · {relativeTime(t.created_at)}
                </p>
              </div>
              {t.rating ? (
                <div class="flex shrink-0 gap-1" aria-label={`${t.rating} out of 5`}>
                  {Array.from({ length: 5 }, (_, i) => (
                    <span class={`size-3 rounded-full ${i < t.rating! ? "bg-gold-500" : "bg-warm-200"}`}></span>
                  ))}
                </div>
              ) : null}
            </div>

            {tab === "pending" ? (
              <form method="POST" action="/api/admin/testimonials/update" class="mt-4">
                <input type="hidden" name="id" value={t.id} />
                {/* Editable in place. Fixing a typo shouldn't mean rejecting. */}
                <textarea
                  name="body" rows="4"
                  class="w-full rounded-md border border-warm-200 bg-cream-100 p-4 text-body leading-relaxed text-warm-900 focus:border-navy-400 focus:bg-white"
                >{t.body}</textarea>
                <div class="mt-3 grid gap-2 sm:grid-cols-2">
                  <input name="name" value={t.name} class="h-12 rounded-md border border-warm-200 bg-cream-100 px-4 text-body focus:border-navy-400 focus:bg-white" />
                  <input name="profession" value={t.profession} class="h-12 rounded-md border border-warm-200 bg-cream-100 px-4 text-body focus:border-navy-400 focus:bg-white" />
                </div>
                <p class="mt-2 text-small text-warm-500">Edit anything above before publishing.</p>

                <button
                  type="submit" name="action" value="publish"
                  class="mt-4 flex min-h-14 w-full items-center justify-center rounded-full bg-navy-600 text-h4 font-bold text-cream-50 hover:bg-navy-500"
                >Approve &amp; publish</button>
                <button
                  type="submit" name="action" value="reject"
                  class="mt-2.5 flex min-h-12 w-full items-center justify-center rounded-full border-[1.5px] border-warm-200 text-body font-bold text-danger hover:border-danger/40"
                >Reject</button>
              </form>
            ) : (
              <>
                <p class="mt-4 rounded-md bg-cream-100 p-4 font-serif text-quote italic leading-relaxed text-warm-900">
                  {t.body}
                </p>
                <form method="POST" action="/api/admin/testimonials/update" class="mt-4 flex flex-wrap gap-2.5">
                  <input type="hidden" name="id" value={t.id} />
                  <button
                    type="submit" name="action" value="feature"
                    class={`min-h-12 rounded-full px-5 text-small font-bold ${t.featured ? "bg-gold-500 text-ink-900" : "border-[1.5px] border-warm-200 text-navy-600"}`}
                  >{t.featured ? "★ On the homepage" : "Show on homepage"}</button>
                  <button
                    type="submit" name="action" value="unpublish"
                    class="min-h-12 rounded-full border-[1.5px] border-warm-200 px-5 text-small font-bold text-warm-700"
                  >Hide</button>
                </form>
              </>
            )}
          </li>
        ))}
      </ul>
    )}

    <div class="mt-9 max-w-[720px] rounded-[18px] bg-ink-900 p-6">
      <p class="eyebrow text-gold-400">The workflow that gets used</p>
      <p class="mt-2.5 text-body leading-relaxed text-cream-50/78">
        When a review arrives you'll get an email with the full text and an
        <strong class="text-cream-50"> Approve &amp; publish</strong> button. One tap and it's live —
        you'll rarely need to open this screen.
      </p>
    </div>
  </div>
</AdminLayout>
