---
/**
 * / — the front door.
 *
 * Fifteen seconds to convince a 30-year-old professional that this is
 * a serious, experienced consultant worth ten minutes of their time.
 *
 * The design specified a background video in the hero. The client has
 * since confirmed there is no video, so this uses a static portrait —
 * which also protects the LCP budget on Sri Lankan mobile data.
 */
export const prerender = false;

import { env } from "cloudflare:workers";
import Layout from "../layouts/Layout.astro";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import StickyBar from "../components/site/StickyBar.astro";
import MilestoneLine from "../components/site/MilestoneLine.tsx";
import LifeStageServices from "../components/site/LifeStageServices.tsx";
import { getSiteSettings, EDGE_CACHE, whatsappHref } from "../lib/settings";
import { services, lifeStages, site } from "../lib/site";

const bindings = env as unknown as Record<string, any>;
const db = bindings.DB;
const settings = await getSiteSettings(db);

// Published reviews only. The section degrades to an invitation when
// there are none — the realistic launch state.
let testimonials: any[] = [];
try {
  if (db) {
    const res = await db
      .prepare(`SELECT name, profession, body, rating FROM testimonials WHERE status='published' ORDER BY featured DESC, sort_order, created_at DESC LIMIT 2`)
      .all();
    testimonials = res.results ?? [];
  }
} catch (e) { console.error("[home] testimonials query failed", e); }

Astro.response.headers.set("cache-control", EDGE_CACHE);

const nodes = [
  { age: 28, milestone: "First car & licence", links: [{ label: "Motor Insurance", href: "/services/motor-insurance" }] },
  {
    age: 32, milestone: "Qualify & practise",
    note: "The moment you can be held personally liable for professional judgement. This is the cover most newly qualified professionals don't know they need.",
    links: [{ label: "Professional Indemnity", href: "/services/professional-indemnity" }],
  },
  { age: 36, milestone: "Marriage & first child", links: [
    { label: "Life & Income Protection", href: "/services/life-income-protection" },
    { label: "Health", href: "/services/health-insurance" }] },
  { age: 42, milestone: "Children's education", links: [{ label: "Children's Education Fund", href: "/services/children-education" }] },
  { age: 50, milestone: "Peak earnings & assets", links: [
    { label: "House & Property", href: "/services/house-property" },
    { label: "Life", href: "/services/life-income-protection" }] },
  { age: 58, milestone: "Retire with an income", links: [{ label: "Retirement Plan", href: "/services/retirement-plan" }] },
];

const differentiators = [
  { lead: "Experience that's been tested", body: `${settings.yearsExperience} years, ${settings.mdrtYears} of them at MDRT level. I've handled this before.` },
  { lead: "I explain, then you decide", body: "No jargon, no pressure. You'll understand exactly what you're buying." },
  { lead: "I'm there at claim time", body: "Anyone can sell a policy. The value shows when you need to claim." },
  { lead: "Available when you need me", body: "Island-wide, and reachable — not a call centre." },
];

const waHero = whatsappHref(settings.whatsapp, "Hello Thushara, I'd like to ask about insurance.");
---

<Layout
  title={site.name}
  description={`${site.title} in Sri Lanka. ${settings.yearsExperience} years, ${settings.mdrtYears}× MDRT Lifetime Member. Insurance and financial planning explained in plain language.`}
>
  <Header slot="header" settings={settings} />

  <!-- ============ HERO ============ -->
  <section class="border-b border-warm-200 bg-cream-50">
    <div class="container-default grid gap-10 px-5 py-14 md:py-20 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-16">
      <div>
        <p class="overline text-teal-400">{site.title} · Sri Lanka</p>
        <h1 class="mt-4 max-w-[16ch] font-display text-display-xl font-extrabold leading-[1.04] tracking-[-0.02em] text-ink-900">
          From your first car to your retirement.
        </h1>
        <p class="mt-6 max-w-[54ch] text-body-lg leading-relaxed text-warm-700">
          {settings.yearsExperience} years advising Sri Lankan professionals, {settings.mdrtYears} of them at MDRT level.
          I explain what you need, what you don't, and what it costs — then you decide.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/book" class="flex min-h-14 items-center justify-center rounded-full bg-teal-600 px-9 text-h4 font-bold text-cream-50 transition-colors hover:bg-teal-500">
            Book a consultation
          </a>
          {waHero && (
            <a href={waHero} class="flex min-h-14 items-center justify-center gap-2.5 rounded-full border-[1.5px] border-teal-600 px-8 text-h4 font-bold text-teal-600 transition-colors hover:bg-teal-50">
              Message on WhatsApp
            </a>
          )}
        </div>
        <p class="mt-4 text-small text-warm-500">Free consultation. No obligation.</p>
      </div>

      <!-- IMG-HERO-01 · pending. Exact dimensions reserved so nothing
           reflows when the real photograph arrives. -->
      <div class="flex aspect-4/5 items-center justify-center rounded-xl border border-warm-200 bg-warm-100 lg:aspect-3/4" data-slot="IMG-HERO-01">
        <span class="max-w-[24ch] px-6 text-center text-caption leading-relaxed text-warm-500">
          <strong class="block text-small text-warm-700">IMG-HERO-01</strong>
          Environmental portrait · 4:5 mobile, 3:4 desktop<br />
          Thushara in his office, natural light, direct eye contact
        </span>
      </div>
    </div>
  </section>

  <!-- ============ CREDENTIALS ============ -->
  <section class="bg-ink-900 py-14 md:py-16">
    <div class="container-default px-5">
      <dl class="grid grid-cols-2 gap-x-6 gap-y-9 md:grid-cols-4 md:divide-x md:divide-cream-50/12">
        {[
          { figure: String(settings.yearsExperience), label: "Years of experience" },
          { figure: `${settings.mdrtYears}×`, label: `MDRT — ${settings.mdrtStatus}` },
          { figure: "Top", label: "Regional performer, Life & General" },
          // A word, not a figure — at 68px "Island-wide" breaks mid-word.
          { figure: "Island-wide", label: settings.serviceArea.replace("Island-wide · ", ""), word: true },
        ].map((s, i) => (
          <div class={i > 0 ? "md:pl-6" : ""}>
            <dt class="sr-only">{s.label}</dt>
            <dd>
              <span class={`block font-display font-extrabold leading-none tabular text-cream-50 ${s.word ? "text-h1 [text-wrap:balance]" : "text-stat"}`}>{s.figure}</span>
              <span class="mt-3 block max-w-[22ch] text-small leading-snug text-teal-300">{s.label}</span>
            </dd>
          </div>
        ))}
      </dl>

      <!-- A 29-year-old doctor has never heard of MDRT. Without this
           the site's strongest credential means nothing to her. -->
      <p class="mt-11 max-w-[72ch] border-t border-cream-50/12 pt-7 text-small leading-relaxed text-cream-50/55">
        MDRT — the Million Dollar Round Table — is a global standard of excellence in financial
        services. Fewer than 1% of advisors qualify. Thushara has qualified {settings.mdrtYears} times,
        across both life and general insurance.
      </p>
    </div>
  </section>

  <!-- ============ LIFE STAGE + SERVICES ============ -->
  <LifeStageServices
    client:visible
    stages={lifeStages.map(({ id, label, ageRange, description }) => ({ id, label, ageRange, description }))}
    services={services.map(({ slug, title, short, lifeStage, icon }) => ({ slug, title, short, lifeStage, icon }))}
  />

  <!-- ============ MILESTONE LINE ============ -->
  <section class="bg-ink-900 py-16 md:py-24">
    <div class="container-default px-5">
      <p class="overline text-gold-400">The long view</p>
      <h2 class="mt-3 max-w-[24ch] font-display text-h2 font-extrabold text-cream-50">
        Insurance isn't one decision. It's six, across thirty years.
      </h2>
      <p class="mt-4 max-w-[62ch] text-body leading-relaxed text-cream-50/70">
        I've walked this line with hundreds of Sri Lankan professionals over {settings.yearsExperience} years.
        Here's where the decisions actually fall.
      </p>

      <div class="mt-12">
        <MilestoneLine client:visible nodes={nodes} initialActive={1} />
      </div>
    </div>
  </section>

  <!-- ============ FOR YOUR PROFESSION ============ -->
  <section class="bg-cream-100 py-16 md:py-24">
    <div class="container-default grid gap-10 px-5 lg:grid-cols-[1fr_1fr] lg:items-center lg:gap-16">
      <div>
        <p class="overline text-teal-400">For your profession</p>
        <h2 class="mt-3 font-display text-h2 font-extrabold text-ink-900">Built around how you actually earn.</h2>
        <p class="mt-4 max-w-[56ch] text-body leading-relaxed text-warm-700">
          Most of my clients are doctors and engineers, so the guides start there. The advice
          underneath is the same for any professional carrying indemnity risk, a vehicle, and
          people who depend on the income.
        </p>

        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a href="/for/doctors" class="flex min-h-14 items-center justify-center rounded-full bg-teal-600 px-7 text-body font-bold text-cream-50 hover:bg-teal-500">
            Read the doctors' guide
          </a>
          <a href="/for/engineers" class="flex min-h-14 items-center justify-center rounded-full border-[1.5px] border-teal-600 px-7 text-body font-bold text-teal-600 hover:bg-teal-50">
            Read the engineers' guide →
          </a>
        </div>
        <p class="mt-4 text-small text-warm-500">Not on the list? The consultation works the same way.</p>
      </div>

      <div class="flex aspect-4/3 items-center justify-center rounded-xl border border-warm-200 bg-warm-100" data-slot="IMG-PROF-01">
        <span class="max-w-[26ch] px-6 text-center text-caption leading-relaxed text-warm-500">
          <strong class="block text-small text-warm-700">IMG-PROF-01 · 4:3</strong>
          Any Sri Lankan professional at work. Not scrubs, not a hard hat.
        </span>
      </div>
    </div>
  </section>

  <!-- ============ WHY WORK WITH ME ============ -->
  <section class="bg-cream-50 py-16 md:py-24">
    <div class="container-default grid gap-10 px-5 lg:grid-cols-[1fr_1.15fr] lg:items-center lg:gap-16">
      <div class="order-2 flex aspect-4/5 items-center justify-center rounded-xl border border-warm-200 bg-warm-100 lg:order-1" data-slot="IMG-WHY-01">
        <span class="max-w-[24ch] px-6 text-center text-caption leading-relaxed text-warm-500">
          <strong class="block text-small text-warm-700">IMG-WHY-01 · 4:5</strong>
          Mid-conversation with a client. Candid, not posed.
        </span>
      </div>

      <div class="order-1 lg:order-2">
        <h2 class="font-display text-h2 font-extrabold text-ink-900">{settings.yearsExperience} years of doing this properly</h2>
        <ul class="mt-8 flex flex-col gap-6">
          {differentiators.map((d) => (
            <li class="border-l-2 border-gold-500 pl-5">
              <p class="text-h4 font-bold text-ink-900">{d.lead}</p>
              <p class="mt-1.5 text-body leading-relaxed text-warm-700">{d.body}</p>
            </li>
          ))}
        </ul>

        <blockquote class="mt-9 border-l-2 border-teal-400 pl-5">
          <p class="font-serif text-quote italic leading-relaxed text-warm-900">
            "Insurance is more than a policy — it is a promise of security and peace of mind."
          </p>
          <footer class="mt-2.5 text-small text-warm-500">Thushara Rathnayake</footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- ============ TESTIMONIALS ============ -->
  <section class="bg-cream-100 py-16 md:py-24">
    <div class="container-default px-5">
      <p class="overline text-teal-400">In their words</p>
      <h2 class="mt-3 font-display text-h2 font-extrabold text-ink-900">What clients say</h2>

      {testimonials.length > 0 ? (
        <ul class="mt-9 grid gap-4 md:grid-cols-2">
          {testimonials.map((t) => (
            <li class="rounded-xl border border-warm-200 bg-cream-50 p-8">
              <p class="font-serif text-quote italic leading-relaxed text-warm-900">"{t.body}"</p>
              <p class="mt-5 text-small font-bold text-ink-900">{t.name}</p>
              <p class="text-small text-warm-500">{t.profession}</p>
            </li>
          ))}
        </ul>
      ) : (
        <div class="mt-9 rounded-xl border border-dashed border-warm-300 bg-cream-50 p-10 text-center">
          <p class="text-h4 font-bold text-ink-900">Reviews are being collected.</p>
          <p class="mx-auto mt-2 max-w-[52ch] text-body leading-relaxed text-warm-700">
            Real client words only — nothing invented. If you've worked with Thushara, yours
            would be the first.
          </p>
          <a href="/testimonials/share" class="mt-6 inline-flex min-h-13 items-center rounded-full border-[1.5px] border-teal-600 px-7 text-body font-bold text-teal-600 hover:bg-teal-50">
            Share your experience
          </a>
        </div>
      )}

      {testimonials.length > 0 && (
        <div class="mt-7 flex flex-wrap gap-x-7 gap-y-2">
          <a href="/testimonials" class="text-body font-bold text-teal-600 underline underline-offset-4">Read all testimonials →</a>
          <a href="/testimonials/share" class="text-body text-warm-500 underline underline-offset-4 hover:text-teal-600">Worked with me? Share your experience →</a>
        </div>
      )}
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="bg-ink-900 py-16 md:py-24">
    <div class="container-default px-5 text-center">
      <h2 class="mx-auto max-w-[18ch] font-display text-h1 font-extrabold text-cream-50">
        Let's talk about where you are.
      </h2>
      <p class="mx-auto mt-5 max-w-[58ch] text-body-lg leading-relaxed text-cream-50/72">
        A free consultation, no obligation. Tell me your situation and I'll tell you honestly
        what you need — and what you don't.
      </p>

      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/book" class="flex min-h-14 items-center justify-center rounded-full bg-gold-500 px-9 text-h4 font-bold text-ink-900 hover:bg-gold-400">
          Book a consultation
        </a>
        {waHero && (
          <a href={waHero} class="flex min-h-14 items-center justify-center rounded-full border-[1.5px] border-cream-50/30 px-8 text-h4 font-bold text-cream-50 hover:border-cream-50">
            Message on WhatsApp
          </a>
        )}
      </div>

      {settings.phoneHref && (
        <a href={settings.phoneHref} class="mt-7 inline-block font-display text-h3 font-extrabold text-cream-50 hover:text-gold-400">
          {settings.phone}
        </a>
      )}
    </div>
  </section>

  <Footer slot="footer" settings={settings} />
  <StickyBar slot="footer" settings={settings} message="Hello Thushara, I'd like to ask about insurance." />
</Layout>
