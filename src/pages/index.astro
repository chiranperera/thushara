---
/**
 * / — the front door. Built against "03 Home.dc.html".
 *
 * Section order follows the design: dark hero → why people stay →
 * life stage → milestone line → services → for your profession →
 * sixteen years → testimonials → guides → CTA.
 *
 * The design's hero carries a background video behind the copy. The
 * client has confirmed there is no video, so the panel holds the
 * gradient alone — which also protects the LCP budget on mobile data.
 */
export const prerender = false;

import { env } from "cloudflare:workers";
import Layout from "../layouts/Layout.astro";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import StickyBar from "../components/site/StickyBar.astro";
import MilestoneLine from "../components/site/MilestoneLine.tsx";
import LifeStageServices from "../components/site/LifeStageServices.tsx";
import HeroVideo from "../components/site/HeroVideo.astro";
import { getSiteSettings, EDGE_CACHE, whatsappHref } from "../lib/settings";
import { services, lifeStages, site } from "../lib/site";

const bindings = env as unknown as Record<string, any>;
const db = bindings.DB;
const settings = await getSiteSettings(db);

let testimonials: any[] = [];
try {
  if (db) {
    const res = await db
      .prepare(`SELECT name, profession, body, rating FROM testimonials WHERE status='published' ORDER BY featured DESC, sort_order, created_at DESC LIMIT 2`)
      .all();
    testimonials = res.results ?? [];
  }
} catch (e) { console.error("[home] testimonials query failed", e); }

Astro.response.headers.set("cache-control", EDGE_CACHE);

const stageIcons: Record<string, string> = {
  "starting-out": "motor",
  "building-family": "house",
  "planning-ahead": "pension",
};

const nodes = [
  { age: 28, milestone: "First car & licence", linkLabel: "Motor Insurance", href: "/services/motor-insurance" },
  {
    age: 32, milestone: "Qualify & practise",
    note: "The moment you can be held personally liable for professional judgement. This is the cover most newly qualified professionals don't know they need.",
    linkLabel: "Professional Indemnity", href: "/services/professional-indemnity",
  },
  { age: 36, milestone: "Marriage & first child", linkLabel: "Life & Income Protection · Health", href: "/services/life-income-protection" },
  { age: 42, milestone: "Children's education", linkLabel: "Children's Education", href: "/services/children-education" },
  { age: 50, milestone: "Peak earnings & assets", linkLabel: "House & Property · Life", href: "/services/house-property" },
  { age: 58, milestone: "Retire with an income", linkLabel: "Retirement Plan", href: "/services/retirement-plan" },
];

const differentiators = [
  { lead: "Experience that's been tested", body: `${settings.yearsExperience} years, ${settings.mdrtYears} of them at MDRT level and ${settings.cotYears} at Court of the Table. I've handled this before.` },
  { lead: "I explain, then you decide", body: "No jargon, no pressure. You'll understand exactly what you're buying." },
  { lead: "I'm there at claim time", body: "Anyone can sell a policy. The value shows when you need to claim." },
  { lead: "Available when you need me", body: "Island-wide, and reachable — not a call centre." },
];

const professions = ["Doctors", "Engineers", "Lawyers", "Architects", "Accountants", "Consultants"];

const guides = [
  { title: "Insurance for Newly Qualified Doctors", body: "What you actually need — and what you can skip for now.", slot: "PDF-001" },
  { title: "Your First Motor Insurance Policy", body: "A plain-English guide to what you're signing.", slot: "PDF-002" },
  { title: "How Much Life Cover Does Your Family Need?", body: "Work out your number in about ten minutes.", slot: "PDF-003" },
];


/**
 * The headline rotates through his services as pairs. Curated, because
 * the two halves have to agree: a starting asset and the thing it
 * eventually pays for. Lengths are kept close so the line does not jump
 * between two and three rows.
 */
const HERO_LINES: [string, string][] = [
  ["car", "retirement"],              // motor -> retirement plan
  ["job", "first home"],              // income protection -> property
  ["home", "children's degree"],      // property -> education fund
  ["trip", "safe return"],            // travel
  ["pay cheque", "pension"],          // income -> retirement
];

const wa = whatsappHref(settings.whatsapp, "Hello Thushara, I'd like to ask about insurance.");
---

<Layout
  title={site.name}
  description={`${site.title} in Sri Lanka. ${settings.yearsExperience} years, ${settings.mdrtYears}× MDRT Lifetime Member. Insurance and financial planning explained in plain language.`}
>
  <Header slot="header" settings={settings} overHero />

  <!-- ============ HERO ============ -->
  <section class="hero-bg relative -mt-20 flex min-h-[720px] flex-col overflow-hidden pt-20 lg:-mt-[104px] lg:min-h-screen lg:max-h-[980px] lg:flex-row lg:pt-[104px]">
    <span aria-hidden="true" class="hero-scrim pointer-events-none absolute inset-0 z-[1]"></span>
    <HeroVideo />

    <!-- copy -->
    <div class="relative z-[3] flex flex-1 flex-col justify-center px-5 pb-8 pt-12 lg:max-w-[60%] lg:flex-none lg:basis-[60%] lg:px-18 lg:pb-0 lg:pt-14">
      <p class="inline-flex items-center gap-2.5 self-start rounded-full border border-cyan-300/28 bg-ink-900/60 py-1.5 pl-2.5 pr-3.5 lg:hidden">
        <span aria-hidden="true" class="size-[7px] rounded-full bg-cyan-300 shadow-[0_0_10px_rgba(125,221,247,0.9)]"></span>
        <span class="overline text-cyan-300">{site.title} · Sri Lanka</span>
      </p>

      {/* Curated pairs rather than a cross-product: every line has to
          read as a real sentence, and "from your first home to your
          first home" is what random combination gives you. Each pair
          spans two of his actual services. The first is server-rendered,
          so crawlers and screen readers get a complete headline whether
          or not the script runs. */}
      <h1
        id="hero-line"
        class="mt-7 min-h-[2.04em] max-w-[16ch] font-display text-display-xl font-extrabold leading-[1.02] tracking-[-0.035em] text-cream-50 [text-wrap:balance] lg:mt-0"
      >
        From your first <span id="hero-a">{HERO_LINES[0][0]}</span> to your{" "}
        <span id="hero-b" class="font-serif font-normal italic tracking-[-0.01em] text-gold-400">{HERO_LINES[0][1]}.</span>
      </h1>

      <p class="mt-7 max-w-[46ch] text-body-lg leading-relaxed text-cream-50/78 lg:text-[21px]">
        {settings.yearsExperience} years advising Sri Lankan professionals, {settings.mdrtYears} of them at MDRT level
        and {settings.cotYears} at Court of the Table. I explain what you need, what you don't.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-4 lg:mt-14">
        <a href="/book" class="flex min-h-14 items-center rounded-full bg-gold-500 px-8 text-h4 font-bold text-ink-900 transition-colors hover:bg-gold-400 lg:min-h-15">
          Book a consultation
        </a>
        {wa && (
          <a target="_blank" rel="noopener noreferrer" href={wa} class="flex min-h-14 items-center gap-2.5 rounded-full border border-cream-50/35 px-7 text-h4 font-bold text-cream-50 transition-colors hover:border-cream-50 lg:min-h-15">
            <span aria-hidden="true" class="size-2.5 rounded-full bg-whatsapp"></span>WhatsApp
          </a>
        )}
        <span class="text-body text-cream-50/55">Free. No obligation.</span>
      </div>

    </div>

    <!-- portrait -->
    <div class="relative z-[3] min-h-[420px] flex-1 overflow-hidden lg:max-w-[40%] lg:flex-none lg:basis-[40%]">
      <picture>
        <source media="(max-width: 767px)" srcset="/img/hero-thushara-award@0.5x.webp" />
        <img
          src="/img/hero-thushara-award.webp"
          alt={`${site.name} receiving a Sri Lanka Insurance Star Award`}
          width="1100" height="2066" fetchpriority="high" decoding="async"
          {/* On desktop the portrait stands on the bottom edge at full height
              which leaves clear space above, below and to its right.
              Mobile keeps the full-bleed bottom-anchored crop — there
              is no room to inset it on a phone. */}
          class="absolute bottom-0 left-1/2 h-full w-full -translate-x-1/2 object-contain object-bottom lg:bottom-0 lg:left-0 lg:h-full lg:translate-x-0 lg:[object-position:left_bottom]"
        />
      </picture>

      {/* Same frame, in motion. The still stays underneath as the
          fallback and is never removed — pull the <video> and the
          picture above is the hero again, unchanged.

          Transparent video has no feature test: Chromium and Firefox
          carry the alpha in VP9/WebM, Safari only in HEVC/MP4, and each
          will happily play the other's file with the alpha silently
          dropped — which would paint an opaque black slab over him. So
          the engine is named rather than probed, and anything not
          recognised keeps the photograph. */}
      <video
        id="hero-portrait-video"
        aria-hidden="true"
        muted loop playsinline preload="none" disableRemotePlayback
        data-webm="/video/thushara.webm"
        data-mp4="/video/thushara.mp4"
        class="absolute bottom-0 left-0 hidden h-[113%] w-full object-contain opacity-0 transition-opacity duration-700 lg:block lg:[object-position:left_bottom]"
      ></video>
    </div>
  </section>

  <script is:inline define:vars={{ lines: HERO_LINES }}>
    // Fades the two halves together so the sentence changes as one
    // thought rather than two words swapping independently.
    (() => {
      const a = document.getElementById("hero-a");
      const b = document.getElementById("hero-b");
      if (!a || !b || lines.length < 2) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      let i = 0;
      let timer = 0;

      // Dips rather than disappears. At zero the sentence reads as
      // "From your first ___ to your ___" for the length of the fade,
      // which looks broken; a short dip reads as the word changing.
      const tick = () => {
        i = (i + 1) % lines.length;
        a.style.opacity = "0.08";
        b.style.opacity = "0.08";
        setTimeout(() => {
          a.textContent = lines[i][0];
          b.textContent = lines[i][1] + ".";
          a.style.opacity = "1";
          b.style.opacity = "1";
        }, 200);
      };

      const start = () => { if (!timer) timer = setInterval(tick, 5000); };
      const stop = () => { clearInterval(timer); timer = 0; };

      for (const el of [a, b]) el.style.transition = "opacity 200ms ease";
      document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
      start();
    })();
  </script>

  <script is:inline>
    (() => {
      const v = document.getElementById("hero-portrait-video");
      if (!v) return;

      const conn = navigator.connection;
      if (conn?.saveData || /(^|-)2g$/.test(conn?.effectiveType ?? "")) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      if (!window.matchMedia("(min-width: 1024px)").matches) return;

      const ua = navigator.userAgent;
      const isSafari = /Safari/.test(ua) && !/Chrome|Chromium|CriOS|FxiOS|Edg|Android/.test(ua);
      const src = isSafari ? v.dataset.mp4 : /Chrome|Chromium|Firefox|Edg/.test(ua) ? v.dataset.webm : null;
      if (!src) return;

      const start = () => {
        v.src = src;
        v.load();
        const still = document.querySelector("picture");
        const restore = () => {
          v.style.opacity = "0";
          if (still) still.style.opacity = "1";
        };
        const show = () => {
          v.style.opacity = "1";
          if (still) {
            still.style.transition = "opacity 700ms ease";
            still.style.opacity = "0";
          }
          v.play().catch(restore);
        };
        v.addEventListener("loadeddata", show, { once: true });
        v.addEventListener("error", restore, { once: true });
      };

      const idle = () =>
        "requestIdleCallback" in window
          ? requestIdleCallback(start, { timeout: 3000 })
          : setTimeout(start, 1200);
      if (document.readyState === "complete") idle();
      else window.addEventListener("load", idle, { once: true });

      document.addEventListener("visibilitychange", () => {
        if (!v.src) return;
        document.hidden ? v.pause() : v.play().catch(() => {});
      });
    })();
  </script>

  <!-- ============ WHY PEOPLE STAY ============ -->
  <section class="bg-mist-50 py-16 md:py-24">
    <div class="container-default grid gap-12 px-5 lg:grid-cols-[0.86fr_1fr] lg:items-center lg:gap-20">
      <div class="relative">
        <img
          src="/img/shot-consulting.webp" alt="Thushara Rathnayake in conversation with a client at his desk"
          width="1200" height="1500" loading="lazy" decoding="async"
          class="aspect-4/5 w-full rounded-xl object-cover"
        />

        <!-- floating MDRT card -->
        <div class="absolute -left-4 top-14 w-[214px] rounded-lg border border-warm-200 bg-white p-5 shadow-[0_18px_40px_rgba(9,20,34,0.16)] sm:-left-8">
          <p class="overline text-warm-500">MDRT qualification</p>
          <div class="mt-3 flex items-end gap-1" aria-hidden="true">
            {Array.from({ length: 8 }, (_, i) => (
              <span
                class="flex-1 rounded-sm"
                style={`height:${14 + i * 3}px;background:${i < 3 ? "#C8DCEF" : i < 6 ? "#4C86C4" : "#123A6B"}`}
              ></span>
            ))}
          </div>
          <p class="mt-3">
            <span class="font-display text-h3 font-extrabold tabular text-ink-900">{settings.mdrtYears}</span>
            <span class="ml-1.5 text-small font-bold text-navy-600">consecutive years</span>
          </p>
          <p class="text-small text-warm-500">{settings.mdrtStatus}</p>
        </div>
      </div>

      <div>
        <p class="overline text-navy-600">Why people stay</p>
        <h2 class="mt-4 max-w-[18ch] font-display text-h2 font-extrabold text-navy-600">
          {settings.yearsExperience} years of the same straight answer.
        </h2>
        <p class="mt-5 max-w-[58ch] text-body-lg leading-relaxed text-warm-700">
          MDRT — the Million Dollar Round Table — is a global standard of excellence in financial
          services. Fewer than 1% of advisors qualify. Thushara has qualified {settings.mdrtYears} times,
          across both life and general insurance.
        </p>
        <a href="/about" class="mt-7 inline-flex min-h-14 items-center rounded-full bg-navy-600 px-8 text-h4 font-bold text-cream-50 hover:bg-navy-500">
          More about Thushara
        </a>

        <dl class="mt-10 grid grid-cols-2 gap-x-4 gap-y-7 border-t border-mist-200 pt-8 sm:grid-cols-4 sm:divide-x sm:divide-mist-200">
          {[
            { figure: String(settings.yearsExperience), label: "Years of experience" },
            { figure: `${settings.mdrtYears}×`, label: `MDRT — ${settings.mdrtStatus}` },
            { figure: "Top", label: "Regional performer" },
            { figure: String(services.length), label: "Covers, Colombo & island-wide" },
          ].map((s, i) => (
            <div class={i > 0 ? "sm:pl-4" : ""}>
              <dt class="sr-only">{s.label}</dt>
              <dd>
                <span class="block font-display text-[44px] font-extrabold leading-none tabular text-navy-600">{s.figure}</span>
                <span class="mt-2.5 block text-small leading-snug text-warm-700">{s.label}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- ============ LIFE STAGE + SERVICES ============ -->
  <LifeStageServices
    client:visible
    stages={lifeStages.map(({ id, label, ageRange, description }) => ({ id, label, ageRange, description, icon: stageIcons[id] }))}
    services={services.map(({ slug, title, short, lifeStage, icon }) => ({ slug, title, short, lifeStage, icon }))}
  />

  <!-- ============ MILESTONE LINE ============ -->
  <section class="bg-ink-900 py-16 md:py-24">
    <div class="container-default px-5">
      <p class="overline text-gold-400">The long view</p>
      <h2 class="mt-4 max-w-[26ch] font-display text-h2 font-bold leading-snug text-cream-50">
        Insurance isn't one decision. It's six, across thirty years.
      </h2>
      <p class="mt-5 max-w-[62ch] text-body-lg leading-relaxed text-cream-50/70">
        I've walked this line with hundreds of Sri Lankan professionals over {settings.yearsExperience} years.
        Here's where the decisions actually fall.
      </p>
      <div class="mt-16">
        <MilestoneLine client:visible nodes={nodes} initialActive={1} />
      </div>
    </div>
  </section>

  <!-- ============ FOR YOUR PROFESSION ============ -->
  <section class="bg-cream-100 py-16 md:py-24">
    <div class="container-default grid gap-12 px-5 lg:grid-cols-2 lg:items-center lg:gap-20">
      <div>
        <p class="overline text-navy-600">For your profession</p>
        <h2 class="mt-4 max-w-[14ch] font-display text-h2 font-extrabold text-navy-600">
          Built around how you actually earn.
        </h2>
        <p class="mt-5 max-w-[58ch] text-body-lg leading-relaxed text-warm-700">
          Most of my clients are doctors and engineers, so the guides start there. The advice
          underneath is the same for any professional carrying indemnity risk, a vehicle, and
          people who depend on the income.
        </p>

        <ul class="mt-7 flex flex-wrap gap-2.5">
          {professions.map((p, i) => (
            <li>
              <span class={`flex min-h-11 items-center rounded-full px-5 text-small font-bold ${
                i < 2 ? "bg-navy-600 text-cream-50" : "border border-warm-300 text-warm-700"
              }`}>{p}</span>
            </li>
          ))}
          <li>
            <span class="flex min-h-11 items-center rounded-full border border-dashed border-warm-300 px-5 text-small text-warm-500">
              Something else
            </span>
          </li>
        </ul>

        <div class="mt-8 flex flex-wrap items-center gap-5">
          <a href="/for/doctors" class="flex min-h-14 items-center rounded-full bg-navy-600 px-8 text-h4 font-bold text-cream-50 hover:bg-navy-500">
            Read the doctors' guide
          </a>
          <a href="/for/engineers" class="text-h4 font-bold text-navy-600 hover:text-navy-400">
            Read the engineers' guide →
          </a>
        </div>
        <p class="mt-4 text-small text-warm-500">Not on the list? The consultation works the same way.</p>
      </div>

      <div class="relative">
        <img
          src="/img/shot-professional.webp" alt="A Sri Lankan professional at work"
          width="1200" height="1500" loading="lazy" decoding="async"
          class="aspect-4/5 w-full rounded-xl object-cover"
        />
        <div class="absolute -left-4 bottom-10 rounded-lg bg-ink-900 px-6 py-5 sm:-left-8">
          <span class="block font-display text-h2 font-extrabold tabular text-gold-400">2</span>
          <span class="mt-1 block max-w-[18ch] text-small leading-snug text-cream-50/70">
            profession guides live, more on request
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SIXTEEN YEARS ============ -->
  <section class="bg-cream-50 py-16 md:py-24">
    <div class="container-default grid gap-12 px-5 lg:grid-cols-[0.8fr_1fr] lg:items-center lg:gap-16">
      <img
          src="/img/shot-explaining.webp" alt="Thushara Rathnayake explaining cover to a client"
          width="1200" height="1500" loading="lazy" decoding="async"
          class="aspect-4/5 w-full rounded-xl object-cover order-2 lg:order-1"
        />

      <div class="order-1 lg:order-2">
        <h2 class="font-display text-h2 font-extrabold text-navy-600">
          {settings.yearsExperience} years of doing this properly
        </h2>
        <ul class="mt-8 flex flex-col gap-6">
          {differentiators.map((d) => (
            <li class="flex gap-4">
              <span aria-hidden="true" class="flex size-11 shrink-0 items-center justify-center rounded-[10px] bg-cream-100">
                <span class="size-3 rotate-45 bg-warm-300"></span>
              </span>
              <span>
                <span class="block text-h4 font-bold text-ink-900">{d.lead}</span>
                <span class="mt-1 block text-body leading-relaxed text-warm-700">{d.body}</span>
              </span>
            </li>
          ))}
        </ul>

        <blockquote class="mt-9 border-l-2 border-gold-500 pl-6">
          <p class="font-serif text-quote italic leading-relaxed text-ink-900">
            "Insurance is more than a policy — it is a promise of security and peace of mind."
          </p>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- ============ TESTIMONIALS ============ -->
  <section class="bg-ink-900 py-16 md:py-24">
    <div class="container-default px-5">
      <div class="flex items-baseline justify-between gap-6">
        <p class="overline text-gold-400">In their words</p>
        {testimonials.length > 0 && (
          <a href="/testimonials" class="text-body font-bold text-cream-50 hover:text-gold-400">Read all testimonials →</a>
        )}
      </div>

      <div class="mt-8 border-t border-cream-50/20 pt-10">
        {testimonials.length > 0 ? (
          <ul class="grid gap-10 md:grid-cols-2 md:divide-x md:divide-cream-50/12">
            {testimonials.map((t, i) => (
              <li class={i > 0 ? "md:pl-10" : ""}>
                <span aria-hidden="true" class="block font-serif text-[42px] leading-none text-gold-400">“</span>
                <p class={`mt-4 font-serif italic leading-relaxed text-cream-50 ${i === 0 ? "text-[26px] md:text-[34px]" : "text-quote"}`}>
                  {t.body}
                </p>
                <p class="mt-7 text-small font-bold text-cream-50">{t.name}</p>
                <p class="text-small text-cream-50/60">{t.profession}</p>
              </li>
            ))}
          </ul>
        ) : (
          <p class="max-w-[56ch] font-serif text-quote italic leading-relaxed text-cream-50/70">
            Reviews are being collected. Real client words only — nothing invented.
          </p>
        )}
      </div>

      <div class="mt-10 border-t border-cream-50/20 pt-7">
        <a href="/testimonials/share" class="text-body text-cream-50/70 hover:text-gold-400">
          Worked with me? Share your experience →
        </a>
      </div>
    </div>
  </section>

  <!-- ============ GUIDES ============ -->
  <section class="bg-cream-50 py-16 md:py-24">
    <div class="container-default px-5">
      <h2 class="font-display text-h2 font-extrabold text-navy-600">Free guides, no jargon</h2>

      <ul class="mt-10 grid gap-4 md:grid-cols-3">
        {guides.map((g) => (
          <li class="flex flex-col rounded-[20px] border border-warm-200 bg-white p-7">
            <span aria-hidden="true" class="flex h-12 w-9 items-center justify-center rounded-sm bg-cream-100"></span>
            <span class="mt-5 font-display text-h4 font-bold leading-snug text-ink-900">{g.title}</span>
            <span class="mt-2.5 flex-1 text-body leading-relaxed text-warm-700">{g.body}</span>
            <span class="mt-4 font-mono text-caption text-warm-400">{g.slot} · file pending</span>
            <span class="mt-5 flex min-h-13 items-center justify-center rounded-full border-[1.5px] border-navy-600 text-body font-bold text-navy-600">
              Download
            </span>
          </li>
        ))}
      </ul>
      <p class="mt-5 text-small text-warm-500">
        Download asks for a name and WhatsApp number only, and tags the lead with which guide was taken.
      </p>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="bg-ink-900 py-20 md:py-28">
    <div class="container-default px-5 text-center">
      <h2 class="mx-auto max-w-[20ch] font-display text-h1 font-extrabold text-cream-50">
        Let's talk about where you are.
      </h2>
      <p class="mx-auto mt-5 max-w-[56ch] text-body-lg leading-relaxed text-cream-50/72">
        A free consultation, no obligation. Tell me your situation and I'll tell you honestly
        what you need — and what you don't.
      </p>

      <div class="mt-9 flex flex-col justify-center gap-4 sm:flex-row">
        <a href="/book" class="flex min-h-15 items-center justify-center rounded-lg bg-gold-500 px-9 text-h4 font-bold text-ink-900 hover:bg-gold-400">
          Book a consultation
        </a>
        {wa && (
          <a target="_blank" rel="noopener noreferrer" href={wa} class="flex min-h-15 items-center justify-center rounded-lg border border-cream-50/40 px-8 text-h4 font-bold text-cream-50 hover:border-cream-50">
            Message on WhatsApp
          </a>
        )}
      </div>

      {settings.phoneHref && (
        <a href={settings.phoneHref} class="mt-8 inline-block font-display text-h4 font-bold text-navy-300 hover:text-gold-400">
          {settings.phone}
        </a>
      )}
    </div>
  </section>

  <Footer slot="footer" settings={settings} />
  <StickyBar slot="footer" settings={settings} message="Hello Thushara, I'd like to ask about insurance." />
</Layout>
